# Never commit real values. NEXT_PUBLIC values are embedded during build.
RESEND_API_KEY=
RESEND_WAITLIST_SEGMENT_ID=
RESEND_FROM_EMAIL=
# Managed PostgreSQL, preferably EU region, TLS required in production.
DATABASE_URL=
MOLLIE_API_KEY=
# Generate 32+ random bytes; keep stable across deployments and payment retries.
ORDER_TOKEN_SECRET=
CHECKOUT_ENABLED=false
CHECKOUT_TEST_MODE=false
CHECKOUT_BASE_URL=https://www.devergetenvader.com
NEXT_PUBLIC_PREORDER_SHIPPING_PERIOD=
# Optional ISO date, only if confirmed (YYYY-MM-DD).
NEXT_PUBLIC_PREORDER_SHIPPING_DATE=
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_RETURN_ADDRESS=
BUSINESS_KVK=
BUSINESS_VAT=
TERMS_APPROVED=false
TERMS_VERSION=2026-09-14
# Secret for protected reconciliation job; schedule every 15 minutes externally.
CRON_SECRET=
GOOGLE_SITE_VERIFICATION=
# Optional GA4. No analytics script is loaded without opt-in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
