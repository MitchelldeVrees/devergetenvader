# Never commit real values (.env.local and .env* are gitignored).
# NEXT_PUBLIC_* values are embedded into the JS bundle at BUILD time —
# changing one in Vercel requires a new deployment to take effect.

# ---- Required for the checkout to be enabled at all ----------------------
CHECKOUT_ENABLED=false
# Managed PostgreSQL, preferably EU region, TLS required in production.
# Use a pooled connection string (e.g. Supabase "Transaction pooler"), not
# the direct connection.
DATABASE_URL=
# test_... while testing, live_... for real sales. Do not change this for
# an order between the moment it is created and the moment its status is
# checked/reconciled — Mollie will reject a payment looked up with the
# wrong mode's key.
MOLLIE_API_KEY=
# Generate 32+ random bytes; keep stable across deployments and payment
# retries (e.g. `openssl rand -hex 32`).
ORDER_TOKEN_SECRET=
# Random secret for the protected reconciliation job (e.g. `openssl rand -hex 32`);
# schedule a GET to /api/orders/reconcile with this bearer token every 15
# minutes externally (e.g. Vercel Cron Jobs).
CRON_SECRET=

# ---- Test mode -------------------------------------------------------------
# true lets you exercise the full checkout with a test_ Mollie key without
# needing the business/shipping fields below filled in yet. Always false
# with a live_ key, and always false before real launch.
CHECKOUT_TEST_MODE=false
# Public HTTPS origin used to build Mollie redirect/webhook URLs.
# https://www.devergetenvader.com in production; a localhost URL is only
# accepted together with CHECKOUT_LOCAL_TEST during local dev.
CHECKOUT_BASE_URL=https://www.devergetenvader.com

# ---- Required for real (non-test-mode) sales ------------------------------
NEXT_PUBLIC_PREORDER_SHIPPING_PERIOD=
# Optional ISO date, only if confirmed (YYYY-MM-DD).
NEXT_PUBLIC_PREORDER_SHIPPING_DATE=
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
RESEND_FROM_EMAIL=
# Real legal/registered seller name — required by Dutch consumer law on
# /algemene-voorwaarden and /privacy. Keep separate from the public author
# pen name in lib/site.ts.
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_KVK=
# Set to true only after the terms/privacy text has actually been reviewed.
TERMS_APPROVED=false

# ---- Optional --------------------------------------------------------------
# Falls back to BUSINESS_ADDRESS if unset.
BUSINESS_RETURN_ADDRESS=
BUSINESS_VAT=
TERMS_VERSION=2026-09-14
# Only needed for the existing waitlist signup feature (full-access Resend key).
RESEND_WAITLIST_SEGMENT_ID=
# Only for Google Search Console domain verification.
GOOGLE_SITE_VERIFICATION=
# Public GA4 measurement ID. No script is loaded without visitor opt-in.
# Defaults to this site's ID in code; set an empty value to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-44KLVCL4WB
